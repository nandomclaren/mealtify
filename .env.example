# Copie este arquivo para ".env" e preencha os valores reais.
# No Railway: Settings > Variables do serviço Postgres (ou "Connect") tem a DATABASE_URL pronta.

DATABASE_URL="postgresql://usuario:senha@host:5432/banco?schema=public"

# Chave da API da Anthropic (console.anthropic.com) usada para gerar o cardápio semanal.
ANTHROPIC_API_KEY="sk-ant-..."
